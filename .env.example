# انسخ هذا الملف إلى .env واملأ القيم.
#   cp .env.example .env
# .env مستبعد من Git عمداً - المفاتيح لا تدخل مستودعاً.

# ── مطلوب ──
# مفتاح OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── البحث ──
# بدونه يعمل الوكيل بلا مصادر حيّة، فتضعف كل التقارير.
# https://serper.dev  (2500 نداء مجاني)
SERPER_API_KEY=

# ── مزوّدون بدلاء (اختياري لكنه أكبر مكسب في السرعة) ──
# التوجيه يختار حسب نوع المهمة ويتجاوز الفاشل تلقائياً. بلا هذه المفاتيح
# يسقط كل شيء على نموذج OpenRouter المجاني، وهو مُطابور ومحدود التزامن -
# وهو سبب أن الموجة الأولى تأخذ 66 ثانية بدل زمن أبطأ وكيل وحده.

# Gemini · https://aistudio.google.com/apikey  (طبقة مجانية سخيّة)
GEMINI_API_KEY=

# Groq · https://console.groq.com/keys        (أسرع استدلال)
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=

# ── النموذج ──
# مجاني ومستقر (اختُبر 4/4): minimax/minimax-m3:free
# تجنّب z-ai/glm-5.2:free - مجمّعه المشترك مزدحم ويرجع upstream_429
MODEL=openrouter/minimax/minimax-m3:free

# ── سلوك التشغيل ──
RUN_TIMEOUT=1500          # سقف زمني صلب للتشغيلة بالثواني
MAKE_PDF=0                # التقرير يُعرض في الصفحة · زرّ «تصدير PDF» يولّده عند الطلب
HIDE_SOURCES=1            # إخفاء المصادر من نص التقرير (تبقى في knowledge.db)

# ── التحديث التلقائي ──
AUTO_UPDATE_HOURS=6       # كل كم ساعة يعمل رادار الفرص · 0 يعطّله
AUTO_UPDATE_DELAY=90      # تأخير أول جولة بعد الإقلاع بالثواني

# ── قاعدة المعرفة ──
# مسار واحد للنسختين (العادية والـEXE) وإلا صار لكلٍّ قاعدته فتتباعدان.
# يُقبل مطلقاً أو نسبياً - والنسبي يُحلّ من مجلد البرنامج لا مجلد التشغيل.
# KNOWLEDGE_DB=

# ── الذاكرة المؤقتة ──
CACHE_TTL_HOURS=6
CHECKPOINT_TTL_HOURS=24
